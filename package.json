{
  "name": "deployra",
  "version": "0.1.9",
  "description": "Lightweight, platform-independent VPS deployment orchestrator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deployra": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e.test.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "deployra",
    "deployment",
    "vps",
    "orchestrator",
    "systemd",
    "git"
  ],
  "author": "litepacks",
  "license": "MIT",
  "dependencies": {
    "@visulima/redact": "^2.0.5",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "nanoid": "^5.0.9",
    "ready-checker": "^1.0.1",
    "unitup": "^0.1.5",
    "workmatic": "^1.1.3",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
